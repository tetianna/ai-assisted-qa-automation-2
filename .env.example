# Copy to .env and fill in. Never commit .env.
# Do not put real secrets in this file.

# --- Run tests (required to clone and run Playwright) ---

# Didaxis Studio base URL (no trailing slash)
DIDAXIS_URL=https://test.didaxis.studio

# Admin (or author) account used by tests/auth.setup.ts storageState
DIDAXIS_EMAIL=your-email@example.com

# Password for DIDAXIS_EMAIL
DIDAXIS_PASSWORD=your-password

# Bearer token for API cleanup (DELETE /api/programs). Login is used if this is unset or invalid.
DIDAXIS_API_TOKEN=your-bearer-token

# Optional: non-admin account for permission probes (tests skip these cases if unset)
DIDAXIS_ALT_EMAIL=alt-user@example.com

# Optional: password for DIDAXIS_ALT_EMAIL
DIDAXIS_ALT_PASSWORD=alt-password

# --- Agent / CI setup (not needed for npx playwright test alone) ---

# Cursor API key for the headless agent in .github/workflows/test-generation.yml
CURSOR_API_KEY=your-cursor-api-key

# Atlassian API token for Jira (CI agent + MCP). Also configure MCP tokens in Cursor settings.
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira Cloud site URL (same cloud used by AGENTS.md / Atlassian MCP)
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email for the API token
ATLASSIAN_EMAIL=your-atlassian-email@example.com

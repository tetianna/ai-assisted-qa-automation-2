# Jira Cloud REST API (for scripts/jira-attach-screenshots.mjs)
# Create token: https://id.atlassian.com/manage-profile/security/api-tokens
# Account must have browse + create attachments on the DS project.
JIRA_SITE=legionqaschool.atlassian.net
JIRA_LOGIN_EMAIL=your-atlassian-email@example.com
JIRA_API_TOKEN=your-jira-api-token
